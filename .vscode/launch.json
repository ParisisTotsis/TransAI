{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "TransAI: Streamlit (F5)",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "app.py",
        "--server.address",
        "127.0.0.1"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}